#version 460 core
layout(local_size_x=OUTPUT_SIZE) in;

layout(binding = MIN_ID_BUFFER_BINDING, std430) restrict readonly buffer VisibilityDataBuffer {
    uint minVisIds[OUTPUT_SIZE];
};

layout(binding = NODE_BUFFER_BINDING, std430) restrict readonly buffer NodeData {
    uvec4[] nodes;
};

layout(binding = OUTPUT_BUFFER_BINDING, std430) restrict writeonly buffer OutputBuffer {
    uvec2 outputBuffer[OUTPUT_SIZE];
};

layout(binding = VISIBILITY_BUFFER_BINDING, std430) restrict buffer VisibilityBuffer {
    uint[] visibility;
};

layout(location=0) uniform uint visibilityCounter;
layout(location=1) uniform uint nodeCount;
const uint CLEANER_INDEX_MASK = (1u << 31) - 1u;

void main() {
    uint outputIndex = gl_GlobalInvocationID.x;
    if (outputIndex >= OUTPUT_SIZE) {
        return;
    }
    // Underfull candidate sets remain absent positions; never dereference their sentinel.
    outputBuffer[outputIndex] = uvec2(-1);
    uint taggedId = minVisIds[outputIndex];
    uint id = taggedId & CLEANER_INDEX_MASK;
    if (taggedId == uint(-1) || id >= nodeCount
            || id >= uint(nodes.length()) || id >= uint(visibility.length())) {
        return;
    }
    // The fuzzy concurrent sort can encounter duplicate IDs. Emit only the first position
    // and update its visibility once, without changing node eligibility or eviction policy.
    for (uint i = 0; i < outputIndex; i++) {
        if ((minVisIds[i] & CLEANER_INDEX_MASK) == id) {
            return;
        }
    }
    uvec4 node = nodes[id];
    if (all(equal(node, uvec4(-1)))) {
        return;
    }
    outputBuffer[outputIndex] = node.xy;//Move the position of the node id into the output buffer

    //This is an evil hack to not spam the same node 500 times in a row
    //TODO: maybe instead set this to the current frame index
//    visibility[id] += 30;
    visibility[id] = visibilityCounter + 60;

}
