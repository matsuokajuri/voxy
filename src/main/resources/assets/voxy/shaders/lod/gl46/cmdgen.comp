#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 128) in;

#define DRAW_BUFFER_BINDING 1
#define DRAW_COUNT_BUFFER_BINDING 2
#define SECTION_METADATA_BUFFER_BINDING 3
#define VISIBILITY_BUFFER_BINDING 4
#define INDIRECT_SECTION_LOOKUP_BINDING 5
#define POSITION_SCRATCH_BINDING 6
#define POSITION_SCRATCH_ACCESS writeonly

#import <voxy:lod/section.glsl>
#import <voxy:lod/gl46/bindings.glsl>

//https://github.com/KhronosGroup/GLSL/blob/master/extensions/ext/GL_EXT_shader_16bit_storage.txt
// adds support for uint8_t which can use for compact visibility buffer


#ifdef HAS_STATISTICS
layout(binding = STATISTICS_BUFFER_BINDING, std430) restrict buffer statisticsBuffer {
    uint visibleSectionCounts[5];
    uint quadCounts[5];
};
#endif

/*
    uint  count;
    uint  instanceCount;
    uint  firstIndex;
    int  baseVertex;
    uint  baseInstance;
    */

layout(binding = TRANSLUCENT_DISTANCE_BUFFER_BINDING, std430) restrict buffer TranslucentCommandCount {
    uint[] translucentCommandData;
};

// A successful counter describes a completely admitted batch, never an attempted
// append. Batches are all-or-none, so no draw can consume an unwritten tail.
uint reserveOpaqueCommands(uint count) {
    if (count == 0u) return 0u;
    uint capacity = min(uint(OPAQUE_DRAW_CAPACITY), uint(cmdBuffer.length()));
    uint observed = atomicAdd(opaqueDrawCount, 0u);
    while (true) {
        if (observed > capacity || count > capacity - observed) {
            atomicOr(commandOverflowFlags, COMMAND_OVERFLOW_OPAQUE);
            atomicAdd(rejectedOpaqueCommands, count);
            return INVALID_COMMAND_INDEX;
        }
        uint previous = atomicCompSwap(opaqueDrawCount, observed, observed + count);
        if (previous == observed) return observed;
        observed = previous;
    }
}

uint reserveTemporalCommands(uint count) {
    if (count == 0u) return uint(TEMPORAL_OFFSET);
    uint available = uint(cmdBuffer.length()) > uint(TEMPORAL_OFFSET)
            ? uint(cmdBuffer.length()) - uint(TEMPORAL_OFFSET) : 0u;
    uint capacity = min(uint(TEMPORAL_DRAW_CAPACITY), available);
    uint observed = atomicAdd(temporalOpaqueDrawCount, 0u);
    while (true) {
        if (observed > capacity || count > capacity - observed) {
            atomicOr(commandOverflowFlags, COMMAND_OVERFLOW_TEMPORAL);
            atomicAdd(rejectedTemporalCommands, count);
            return INVALID_COMMAND_INDEX;
        }
        uint previous = atomicCompSwap(temporalOpaqueDrawCount, observed, observed + count);
        if (previous == observed) return observed + uint(TEMPORAL_OFFSET);
        observed = previous;
    }
}

uint reserveTranslucentCommand() {
    uint available = uint(cmdBuffer.length()) > uint(TRANSLUCENT_OFFSET)
            ? uint(cmdBuffer.length()) - uint(TRANSLUCENT_OFFSET) : 0u;
    uint listAvailable = uint(translucentCommandData.length()) > uint(TRANSLUCENT_WRITE_BASE)
            ? uint(translucentCommandData.length()) - uint(TRANSLUCENT_WRITE_BASE) : 0u;
    uint capacity = min(uint(TRANSLUCENT_DRAW_CAPACITY), min(available, listAvailable));
    uint observed = atomicAdd(translucentDrawCount, 0u);
    while (true) {
        if (observed >= capacity) {
            atomicOr(commandOverflowFlags, COMMAND_OVERFLOW_TRANSLUCENT);
            atomicAdd(rejectedTranslucentCommands, 1u);
            return INVALID_COMMAND_INDEX;
        }
        uint previous = atomicCompSwap(translucentDrawCount, observed, observed + 1u);
        if (previous == observed) return observed + uint(TRANSLUCENT_WRITE_BASE);
        observed = previous;
    }
}

void rejectInput() {
    atomicOr(commandOverflowFlags, COMMAND_INVALID_INPUT);
    atomicAdd(rejectedCommandInputs, 1u);
}

//Note: if i want reverse indexing i need to use the index buffer offset to offset
void writeCmd(uint idx, uint instance, uint offset, uint quadCount) {
    DrawCommand cmd;
    cmd.count = quadCount * 6;
    cmd.instanceCount = 1;
    cmd.firstIndex = 0;
    cmd.baseVertex = int(offset)<<2;
    cmd.baseInstance = instance;
    cmdBuffer[idx] = cmd;
}

void writeOpaqueCommands(inout uint opaquePtr, inout uint temporalPtr,
                         uint instance, uint offset, uint quadCount) {
    if (opaquePtr != INVALID_COMMAND_INDEX) {
        writeCmd(opaquePtr++, instance, offset, quadCount);
    }
    if (temporalPtr != INVALID_COMMAND_INDEX) {
        writeCmd(temporalPtr++, instance, offset, quadCount);
    }
}

void main() {
    uint validSectionCount = min(sectionCount, min(uint(RENDER_LIST_CAPACITY), uint(indirectLookup.length())));
    if (gl_GlobalInvocationID.x >= validSectionCount) {
        return;
    }
    if (gl_GlobalInvocationID.x >= uint(positionBuffer.length())) {
        rejectInput();
        return;
    }
    uint sectionId = indirectLookup[gl_GlobalInvocationID.x];
    if (sectionId >= uint(sectionData.length()) || sectionId >= uint(visibilityData.length())) {
        rejectInput();
        return;
    }
    SectionMeta meta = sectionData[sectionId];
    uint detail = extractDetail(meta);
    if (detail > uint(MAX_LOD_LAYER)) {
        rejectInput();
        return;
    }
    ivec3 ipos = extractPosition(meta);

    vec3 cornerPos = vec3(((ipos<<detail)-baseSectionPos)<<5)-cameraSubPos;


    uint dat = visibilityData[sectionId];

    //if the section was visible this frame
    bool shouldRender = (dat&0x7fffffffu) == frameId;
    bool renderTemporally = (dat&0x80000000u)==0;// means, if it was not visible last frame



    if (shouldRender) {

        #ifdef HAS_STATISTICS
        atomicAdd(visibleSectionCounts[detail], 1);
        #endif

        uint ptr = extractQuadStart(meta);
        ivec3 relative = ipos-(baseSectionPos>>detail);
        uint drawId = gl_GlobalInvocationID.x;

        positionBuffer[drawId] = extractRawPos(meta);
        uvec4 counts = meta.b;

        // Preserve the original directional commands; merging is a separate
        // measured optimization. Each section can reserve at most seven.
        uint msk = 0;
        msk |= uint(((counts.y      &0xFFFFu)!=0) && (relative.y>-1))<<0;
        msk |= uint((((counts.y>>16)&0xFFFFu)!=0) && (relative.y<1 ))<<1;
        msk |= uint(((counts.z      &0xFFFFu)!=0) && (relative.z>-1))<<2;
        msk |= uint((((counts.z>>16)&0xFFFFu)!=0) && (relative.z<1 ))<<3;
        msk |= uint(((counts.w      &0xFFFFu)!=0) && (relative.x>-1))<<4;
        msk |= uint((((counts.w>>16)&0xFFFFu)!=0) && (relative.x<1 ))<<5;

        msk |= uint(((counts.x>>16)&0xFFFFu)!=0)<<6;


        uint cmdCnt = bitCount(msk);
        uint cmdPtr = reserveOpaqueCommands(cmdCnt);

        uint tCmdPtr = INVALID_COMMAND_INDEX;
        if (renderTemporally && cmdPtr != INVALID_COMMAND_INDEX) {
            tCmdPtr = reserveTemporalCommands(cmdCnt);
        }

        // Count admitted scene quads once; temporal commands duplicate these
        // quads to cover the first visible frame, not additional geometry.
        #ifdef HAS_STATISTICS
        uint totalQuads = 0;
        #endif

        uint count = 0;
        //Translucency
        count = counts.x&0xFFFFu;
        if (count != 0) {
            uint tp = reserveTranslucentCommand();
            if (tp != INVALID_COMMAND_INDEX) {
                translucentCommandData[tp] = drawId;
                uvec3 absRel = abs(relative);
                uint distToCamera = (absRel.x+absRel.y+absRel.z)<<detail;
                // Only admitted list entries contribute to the histogram.
                distToCamera = (TRANSLUCENT_WRITE_BASE-1)-min(distToCamera, (TRANSLUCENT_WRITE_BASE-1));
                atomicAdd(translucentCommandData[distToCamera], 1);
                #ifdef HAS_STATISTICS
                totalQuads += count;
                #endif
            }
        }
        ptr += count;

        //Double sided quads
        count = (counts.x>>16)&0xFFFFu;
        if (count != 0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //Down
        count = (counts.y)&0xFFFFu;
        if (((msk&(1u<<0))!=0)) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //Up
        count = (counts.y>>16)&0xFFFFu;
        if ((msk&(1u<<1))!=0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //North
        count = (counts.z)&0xFFFFu;
        if ((msk&(1u<<2))!=0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //South
        count = (counts.z>>16)&0xFFFFu;
        if ((msk&(1u<<3))!=0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //West
        count = (counts.w)&0xFFFFu;
        if ((msk&(1u<<4))!=0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        //East
        count = (counts.w>>16)&0xFFFFu;
        if ((msk&(1u<<5))!=0) {
            writeOpaqueCommands(cmdPtr, tCmdPtr, drawId, ptr, count);
            #ifdef HAS_STATISTICS
            if (cmdPtr != INVALID_COMMAND_INDEX) totalQuads += count;
            #endif
        }
        ptr += count;

        #ifdef HAS_STATISTICS
        atomicAdd(quadCounts[detail], totalQuads);
        #endif
    }
}
